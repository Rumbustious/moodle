{{!
  Technical support manage tickets template.
  @package local_helpdesk
}}
<div class="local-helpdesk-manage container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{{#str}}managetickets, local_helpdesk{{/str}}</h2>

        {{#isadmin}}
        <a href="{{adminlogurl}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-list"></i> {{#str}}adminlog, local_helpdesk{{/str}}
        </a>
        {{/isadmin}}
    </div>

    <!-- STATUS TABS -->
    <ul class="nav nav-tabs mb-2">
        {{#statustabs}}
        <li class="nav-item">
            <a class="nav-link {{#selected}}active{{/selected}}" href="{{url}}">
                {{label}}
            </a>
        </li>
        {{/statustabs}}
    </ul>

    <!-- PRIORITY TABS -->
    <ul class="nav nav-pills mb-2">
        {{#prioritytabs}}
        <li class="nav-item">
            <a class="nav-link {{#selected}}active bg-info text-white{{/selected}}" href="{{url}}">
                {{label}}
            </a>
        </li>
        {{/prioritytabs}}
    </ul>

    <!-- ASSIGNMENT TABS -->
    <ul class="nav nav-pills mb-3">
        {{#assignmenttabs}}
        <li class="nav-item">
            <a class="nav-link {{#selected}}active bg-secondary text-white{{/selected}}" href="{{url}}">
                {{label}}
            </a>
        </li>
        {{/assignmenttabs}}
    </ul>

    <!-- FILTER FORM -->
    <div class="card mb-3">
        <div class="card-header">
            <i class="fa fa-filter"></i> {{#str}}advancedfilters, local_helpdesk{{/str}}
        </div>

        <div class="card-body">
            <form method="get" action="{{filterformurl}}" class="row" id="filterForm">

                <!-- Ticket ID -->
                <div class="col-md-3 mb-2">
                    <label>{{#str}}ticketid, local_helpdesk{{/str}}</label>
                    <input type="number" name="ticketid" class="form-control" value="{{ticketid}}">
                </div>

                <!-- Search -->
                <div class="col-md-3 mb-2">
                    <label>{{#str}}search, local_helpdesk{{/str}}</label>
                    <input type="text" name="search" class="form-control"
                           value="{{search}}" placeholder="{{#str}}searchsubject, local_helpdesk{{/str}}">
                </div>

                <!-- Created By -->
                <div class="col-md-3 mb-2">
                    <label>{{#str}}createdby, local_helpdesk{{/str}}</label>
                    <select name="createdby" class="form-control">
                        {{#useroptions}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>
                            {{label}}
                        </option>
                        {{/useroptions}}
                    </select>
                </div>

                <!-- Course -->
                <div class="col-md-3 mb-2">
                    <label>{{#str}}course, local_helpdesk{{/str}}</label>
                    <select name="courseid" class="form-control">
                        {{#courseoptions}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>
                            {{label}}
                        </option>
                        {{/courseoptions}}
                    </select>
                </div>

                <!-- Assigned To -->
                <div class="col-md-3 mb-2">
                    <label>{{#str}}assignedto, local_helpdesk{{/str}}</label>
                    <select name="assignedto" class="form-control">
                        {{#assignedoptions}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>
                            {{label}}
                        </option>
                        {{/assignedoptions}}
                    </select>
                </div>

                <!-- Date From -->
                <div class="col-md-2 mb-2">
                    <label>{{#str}}fromdate, local_helpdesk{{/str}}</label>
                    <input type="date" name="createdfrom" class="form-control" value="{{createdfrom}}">
                </div>

                <!-- Date To -->
                <div class="col-md-2 mb-2">
                    <label>{{#str}}todate, local_helpdesk{{/str}}</label>
                    <input type="date" name="createdto" class="form-control" value="{{createdto}}">
                </div>

                <!-- Apply Button -->
                <div class="col-md-2 d-flex align-items-end mb-2">
                    <button type="submit" class="btn btn-primary w-100">
                        {{#str}}applyfilters, local_helpdesk{{/str}}
                    </button>
                </div>

                <!-- Clear Button (now JavaScript-driven) -->
                <div class="col-md-2 d-flex align-items-end mb-2">
                    <button type="button" id="clearFiltersBtn" class="btn btn-secondary w-100">
                        {{#str}}clearfilters, local_helpdesk{{/str}}
                    </button>
                </div>

            </form>
        </div>
    </div>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const createdToInput = document.querySelector('input[name="createdto"]');

    if (createdToInput && !createdToInput.value) {
        const today = new Date();

        // Format YYYY-MM-DD (required by input[type=date])
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');

        createdToInput.value = `${yyyy}-${mm}-${dd}`;
    }

});
</script>
    <!-- JavaScript to clear filters -->
    <script>
    document.getElementById('clearFiltersBtn').addEventListener('click', function() {
        // Reset all form fields to their default values
        var form = document.getElementById('filterForm');
        form.reset();
        // Also explicitly set select elements to the "All" option (value = 0 or empty)
        var selects = form.querySelectorAll('select');
        selects.forEach(function(select) {
            if (select.name === 'createdby' || select.name === 'courseid' || select.name === 'assignedto') {
                // Find the option with value "0" (all) and select it
                var allOption = Array.from(select.options).find(opt => opt.value === '0');
                if (allOption) {
                    allOption.selected = true;
                } else {
                    select.selectedIndex = 0;
                }
            }
        });
        // Submit the form to the base URL (without any filter parameters)
        // The action already points to the base URL, but we need to ensure no extra params are appended
        form.action = '{{filterformurl}}'; // already set, but ensure it's the clean URL
        form.submit();
    });
    </script>

    <!-- NO DATA -->
    {{#notickets}}
    <div class="alert alert-info">
        {{#str}}notickets, local_helpdesk{{/str}}
    </div>
    {{/notickets}}

    <!-- TABLE -->
    {{^notickets}}
    <div class="table-responsive">
        <table class="table table-striped table-hover generaltable">

            <thead>
                <tr>
                    <th>#</th>
                    <th>{{#str}}ticketsubject, local_helpdesk{{/str}}</th>
                    <th>{{#str}}createdby, local_helpdesk{{/str}}</th>
                    <th>{{#str}}course, local_helpdesk{{/str}}</th>
                    <th>{{#str}}ticketpriority, local_helpdesk{{/str}}</th>
                    <th>{{#str}}status, local_helpdesk{{/str}}</th>
                    <th>{{#str}}createdon, local_helpdesk{{/str}}</th>
                    <th>{{#str}}actions, local_helpdesk{{/str}}</th>
                </tr>
            </thead>

            <tbody>
                {{#tickets}}
                <tr>
                    <td>{{id}}</td>
                    <td>{{subject}}</td>
                    <td>{{ownername}} <small class="text-muted">({{ownerusername}})</small></td>
                    <td>{{coursename}}</td>
                    <td><span class="badge badge-{{prioritykey}}">{{priority}}</span></td>
                    <td><span class="badge helpdesk-status-{{statuskey}}">{{status}}</span></td>
                    <td>{{timecreated}}</td>
                    <td>
                        <a href="{{viewurl}}" class="btn btn-sm btn-outline-primary">
                            {{#str}}viewticket, local_helpdesk{{/str}}
                        </a>
                    </td>
                </tr>
                {{/tickets}}
            </tbody>

        </table>
    </div>
    {{/notickets}}

</div>

<style>
.helpdesk-status-open       { background-color: #17a2b8; color: #fff; }
.helpdesk-status-inprogress { background-color: #ffc107; color: #212529; }
.helpdesk-status-resolved   { background-color: #28a745; color: #fff; }
.helpdesk-status-closed     { background-color: #6c757d; color: #fff; }

.badge-low    { background-color: #6c757d; color: #fff; }
.badge-medium { background-color: #17a2b8; color: #fff; }
.badge-high   { background-color: #fd7e14; color: #fff; }
.badge-urgent { background-color: #dc3545; color: #fff; }
</style>